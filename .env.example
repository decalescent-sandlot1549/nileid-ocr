# ─────────────────────────────────────────────────────────────────────
# NileID — example configuration.
# Copy to `.env` and adjust. `.env` is git-ignored and must never be
# committed. Every value below is a placeholder, not a real secret.
# ─────────────────────────────────────────────────────────────────────

# Directory containing the YOLO weight files.
# Populate it with: python scripts/download_models.py
NILEID_MODEL_DIR=models

# Inference device: "auto" | "cpu" | "cuda" | "cuda:0"
NILEID_DEVICE=auto

# OCR engines to enable, comma separated: easyocr,paddleocr
NILEID_OCR_ENGINES=easyocr

# Log level: DEBUG | INFO | WARNING | ERROR
NILEID_LOG_LEVEL=INFO

# Maximum accepted upload size for the HTTP API, in megabytes.
NILEID_MAX_UPLOAD_MB=10

# Minimum confidence for accepting a card detection (0.0 - 1.0).
NILEID_CARD_CONF=0.25

# Minimum confidence for accepting a field detection (0.0 - 1.0).
NILEID_FIELD_CONF=0.20
